# Kopieren nach .env und anpassen:  cp .env.example .env && chmod 600 .env

# Kennung des Sensors. Der Sensor muss vorher auf dem NAS angelegt sein (siehe
# README): nur a-z, 0-9, - und _.
SENSOR_ID=rack-a

# Adresse des Servers, eine von beiden, ohne Pfad. Nicht das Dashboard (50000)!
#   http://<NAS-IP>:50001    im selben Netz wie das NAS
#   https://api.odidumm.com   von überall, sobald sie im Cloudflare Tunnel eingetragen ist
BASE_URL=http://<NAS-IP>:50001

# Token des Sensors. "flask sensor add" auf dem NAS zeigt es genau einmal an.
# Nur das Token selbst eintragen, ohne "Bearer" davor (das setzt das Programm).
API_TOKEN=bitte-aendern

# Token für POST /led der lokalen API, mindestens 16 Zeichen. Wer es kennt,
# kann die Alarm-LEDs abschalten. Zufällig erzeugen, z. B.:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
# Solange hier der Platzhalter steht, startet der Dienst nicht.
LOCAL_TOKEN=bitte-aendern

# GPIOs der LEDs (BCM-Nummern)
# rot = Alarm, GPIO 17 = physischer Pin 11
LED_RED_PIN=17
# gelb = Warnung (blinkt bei Sensorausfall), GPIO 27 = physischer Pin 13
LED_YELLOW_PIN=27

# Messintervall in Sekunden, pi-api.txt nennt 30. Kleinster Wert ist 1: Eine Messung
# des DS18B20 dauert 0,8 s. Nach über 120 s ohne Meldung gilt der Sensor im
# Dashboard als offline.
INTERVAL_S=30

# Die Grenzwerte stehen nicht hier, sie kommen aus dem Dashboard.

# ---------------------------------------------------------------- optional
# Adresse und Port der lokalen REST-API. 127.0.0.1 = nur vom Pi selbst erreichbar
#LOCAL_HOST=0.0.0.0
#LOCAL_PORT=8080
# Bestimmten 1-Wire-Sensor verwenden (sonst der erste 28-* unter /sys/bus/w1/devices)
#W1_DEVICE_ID=28-5a097e0f64ff
#LOG_LEVEL=INFO
# Datei für Grenzwerte und letzte Stufe. Standard: unter systemd /var/lib/temp-monitor/state.json,
# sonst ./state.json
#STATE_FILE=/var/lib/temp-monitor/state.json

# ------------------------------------------- nur zum Testen ohne Hardware
# Fake-Sensor statt DS18B20: fester Wert oder Wert aus einer Datei.
# Achtung: Unter systemd hat der Dienst ein eigenes /tmp (PrivateTmp), dort
# also z. B. /var/lib/temp-monitor/fake_temp nehmen. /tmp/... nur beim Start von Hand.
#SENSOR_BACKEND=fake
#FAKE_TEMP_C=22.0
#FAKE_TEMP_FILE=/var/lib/temp-monitor/fake_temp
# LEDs nur simulieren (gpiozero-Mock statt echtem GPIO)
#GPIOZERO_PIN_FACTORY=mock
